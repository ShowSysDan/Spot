# --- Database ---
# Shared Postgres instance; Spot uses an isolated schema (default: spot).
SPOT_DB_HOST=127.0.0.1
SPOT_DB_PORT=5432
SPOT_DB_NAME=shared
SPOT_DB_USER=spot_user
SPOT_DB_PASSWORD=changeme
SPOT_DB_SCHEMA=spot

# --- Web ---
SPOT_WEB_HOST=0.0.0.0
SPOT_WEB_PORT=6100

# --- Syslog ---
# Either a local socket (e.g. /dev/log) or host:port for a remote rsyslog/syslog-ng.
SPOT_SYSLOG_ADDRESS=/dev/log
SPOT_SYSLOG_FACILITY=local0
SPOT_LOG_LEVEL=INFO

# --- Misc ---
# Secret used by Flask sessions (no auth currently, but kept for flash messages).
SPOT_SECRET_KEY=please-change-me
# Comma-separated trusted ingest sources, or leave empty to allow any.
SPOT_INGEST_ALLOW=

# How often the retention janitor runs (seconds; minimum effective = 60).
SPOT_JANITOR_INTERVAL_SECONDS=3600

# Default retention applied to monitors that don't set their own (days).
# Leave blank to keep data forever unless a per-monitor policy exists.
SPOT_DEFAULT_RETENTION_DAYS=

# --- Time ---
# Every time people see (pages, charts, PDFs, CSVs, e-mails) is shown in this
# IANA zone, 24-hour. America/New_York switches between EST and EDT itself.
# Data is always stored in UTC; changing this only changes the display.
SPOT_TIMEZONE=America/New_York

# Base URL of this Spot install, used for links in e-mails, webhooks and API
# responses. Leave blank to derive it from each request.
SPOT_PUBLIC_URL=

# --- E-mail (alerts and show reports) ---
# Leave SPOT_SMTP_HOST blank to turn e-mail off.
SPOT_SMTP_HOST=
SPOT_SMTP_PORT=587
# starttls (port 587), ssl (port 465) or none (internal relay on port 25).
SPOT_SMTP_SECURITY=starttls
SPOT_SMTP_USER=
SPOT_SMTP_PASSWORD=
SPOT_SMTP_FROM=spot@localhost

# --- Alerts ---
# Comma-separated addresses that receive alert / recovery e-mails.
SPOT_ALERT_EMAIL_TO=
# Optional URL that receives a JSON POST for each alert / recovery.
SPOT_ALERT_WEBHOOK_URL=
# How often thresholds are checked (seconds, minimum 5).
SPOT_ALERT_INTERVAL_SECONDS=15

# --- External systems ---
# Optional allow-list for show-report callback URLs: hostnames and/or CIDR
# ranges, comma-separated. Blank = any host except link-local / reserved
# addresses (e.g. 169.254.169.254). Redirects are never followed.
SPOT_CALLBACK_ALLOW=
